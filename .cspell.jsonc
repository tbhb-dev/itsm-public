{
  "language": "en",
  "ignorePaths": [
    "**/*.log",
    "**/.DS_Store",
    "apm_modules/**/*",
    // Agent primitives deployed from tbhb-dev/devtools and pinned by
    // content hash in apm.lock.yaml. Their vocabulary is upstream's.
    ".agents/skills/**/*",
    ".agents/rules/**/*",
    ".claude/rules/**/*",
    ".claude/skills/**/*",
    ".claude/worktrees/**/*",
    ".codex/worktrees/**/*",
    // The vendored devtools payload answers to the publisher's dictionary.
    ".config/mise/**/*",
    ".devtools/**/*",
    ".fix-prose/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    "apm.lock.yaml",
    // Generated lockfiles contain tool names and checksums.
    "mise.lock",
    "vendir.lock.yml",
    // Private values, gitignored; nothing in it belongs in a dictionary.
    "mise.local.toml"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project"]
}
